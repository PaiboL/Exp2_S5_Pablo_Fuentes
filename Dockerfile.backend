FROM maven:3.9.11-eclipse-temurin-17 AS build
WORKDIR /src
ARG SERVICE
COPY microservicios/${SERVICE}/pom.xml pom.xml
RUN mvn -B -ntp dependency:go-offline
COPY microservicios/${SERVICE}/src src
RUN mvn -B -ntp verify
FROM eclipse-temurin:17-jre-jammy
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/* && useradd -r -u 10001 app
WORKDIR /app
COPY --from=build /src/target/*-1.0.0.jar /app/app.jar
USER 10001
ENTRYPOINT ["java","-XX:MaxRAMPercentage=70","-jar","/app/app.jar"]
