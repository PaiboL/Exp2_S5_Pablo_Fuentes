      "name": "01 Salud usuarios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{usuariosUrl}}/actuator/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Respuesta JSON\", () => pm.response.to.be.json);"
