{
  "info": {
    "name": "DSY2205 Foro academico",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden sobre semillas iniciales. Crea y elimina recursos temporales. No incluye video."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.iteration === 0 && pm.info.requestName.startsWith(\"01 \")) { const n=Date.now(); pm.environment.set(\"testEmail\", \"prueba\"+n+\"@foro.local\"); pm.environment.set(\"testCategory\", \"Temporal \"+n); }"
        ]
      }
    }
  ],
